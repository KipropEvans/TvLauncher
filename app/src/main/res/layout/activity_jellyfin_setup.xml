<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/black" android:orientation="vertical" android:gravity="center"
    android:paddingStart="300dp" android:paddingEnd="300dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Connect to Jellyfin" android:textColor="@color/white"
        android:textSize="34sp" android:textStyle="bold" android:layout_marginBottom="40dp"/>

    <EditText android:id="@+id/jf_url"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Server address (http://192.168.1.10:8096)"
        android:textColorHint="@color/light_gray" android:textColor="@color/white"
        android:inputType="textUri" android:backgroundTint="@color/light_gray"/>

    <EditText android:id="@+id/jf_user"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Username" android:textColorHint="@color/light_gray"
        android:textColor="@color/white" android:backgroundTint="@color/light_gray"
        android:layout_marginTop="24dp"/>

    <EditText android:id="@+id/jf_pass"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Password" android:textColorHint="@color/light_gray"
        android:textColor="@color/white" android:inputType="textPassword"
        android:backgroundTint="@color/light_gray" android:layout_marginTop="24dp"/>

    <Button android:id="@+id/jf_connect"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Connect" android:backgroundTint="@color/apple_blue"
        android:layout_marginTop="40dp"/>
</LinearLayout>