<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center" android:padding="24dp"
    android:focusable="true" android:clickable="true">

    <ImageView android:id="@+id/profile_avatar"
        android:layout_width="110dp" android:layout_height="110dp"
        android:src="@drawable/circle_avatar_bg" android:padding="30dp"/>

    <TextView android:id="@+id/profile_name"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/light_gray" android:textSize="16sp" android:layout_marginTop="14dp"/>
</LinearLayout>