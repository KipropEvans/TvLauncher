<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingEnd="16dp"
    android:focusable="true" android:clickable="true">

    <FrameLayout android:id="@+id/card"
        android:layout_width="180dp" android:layout_height="270dp"
        android:background="@drawable/card_background">

        <ImageView android:id="@+id/content_image"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop"/>

        <View android:id="@+id/progress_bar"
            android:layout_width="0dp" android:layout_height="4dp"
            android:layout_gravity="bottom" android:background="@color/apple_blue"
            android:visibility="gone"/>
    </FrameLayout>

    <TextView android:id="@+id/content_title"
        android:layout_width="180dp" android:layout_height="wrap_content"
        android:textColor="@color/light_gray" android:textSize="13sp"
        android:maxLines="1" android:ellipsize="end" android:layout_marginTop="8dp"/>
</LinearLayout>