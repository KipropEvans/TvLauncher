<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="700dp" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@drawable/card_background"
    android:padding="10dp" android:layout_marginBottom="16dp"
    android:focusable="true" android:clickable="true">

    <FrameLayout android:layout_width="220dp" android:layout_height="124dp">

        <ImageView android:id="@+id/ep_thumb"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop"/>

        <TextView android:id="@+id/ep_number"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:textColor="@color/white"
            android:textSize="34sp" android:textStyle="bold"
            android:shadowColor="#AA000000" android:shadowRadius="8" android:padding="8dp"/>

        <View android:id="@+id/ep_progress"
            android:layout_width="0dp" android:layout_height="3dp"
            android:layout_gravity="bottom" android:background="@color/apple_blue"
            android:visibility="gone"/>
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:layout_marginStart="18dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/ep_title"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="17sp"/>

            <TextView android:id="@+id/ep_duration"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/light_gray" android:textSize="13sp"/>
        </LinearLayout>

        <TextView android:id="@+id/ep_desc"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/light_gray" android:textSize="13sp"
            android:maxLines="2" android:ellipsize="end" android:layout_marginTop="6dp"/>
    </LinearLayout>
</LinearLayout>