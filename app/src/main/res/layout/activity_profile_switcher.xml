<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/black" android:orientation="vertical" android:gravity="center">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Who's watching?" android:textColor="@color/white" android:textSize="34sp"
        android:textStyle="bold" android:layout_marginBottom="48dp"/>

    <LinearLayout android:id="@+id/profiles_row"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal"/>
</LinearLayout>